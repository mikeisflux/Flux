+// SidePanelWebUIViewT declares its metadata with METADATA_TEMPLATE_HEADER,
+// which leaves the definitions to whoever instantiates it. Omitting this is a
+// link error, not a compile error.
+using SidePanelWebUIViewT_FluxUI = SidePanelWebUIViewT<flux::FluxUI>;
+BEGIN_TEMPLATE_METADATA(SidePanelWebUIViewT_FluxUI, SidePanelWebUIViewT)
+END_METADATA
+
+namespace {
+
+// Flux has no per-window state of its own, so unlike the panels around it
+// there is no coordinator to own - the view is all there is.
+std::unique_ptr<views::View> CreateFluxWebView(SidePanelEntryScope& scope) {
+  return std::make_unique<SidePanelWebUIViewT<flux::FluxUI>>(
+      scope, base::RepeatingClosure(), base::RepeatingClosure(),
+      std::make_unique<WebUIContentsWrapperT<flux::FluxUI>>(
+          GURL(chrome::kChromeUIFluxURL),
+          scope.GetBrowserWindowInterface().GetProfile(), IDS_PRODUCT_NAME,
+          /*esc_closes_ui=*/false));
+}
+
+// The reference design's sidebar width. This is a starting width: once the
+// user drags the resize handle, prefs::kSidePanelIdToWidth wins instead.
+int FluxDefaultContentWidth() {
+  return 305;
+}
+
+}  // namespace
 
