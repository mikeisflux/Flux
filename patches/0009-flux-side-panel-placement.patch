Subject: [flux] Put the Flux console where the design calls for it

Three separate things decide where the panel appears, and Chromium's defaults
are wrong for all three:

Width. kSidePanelDefaultContentWidth is both the default and the floor, and
at 360 it silently clamps the 305 the design specifies - GetDefaultContentWidth
discards anything below it and SidePanel::GetMinimumSize refuses to resize
below it. Splitting the floor out as kSidePanelMinimumContentWidth lets Flux
open at 305 while every other panel keeps its 360 default.

Side. kSidePanelAlignmentOverrides already exists for exactly this, keyed by
entry id; kContextualTasks uses it the same way. The stored value is "is right
aligned", so IsRTL() means the leading edge.

Open state. A sidebar you have to go find is not a sidebar. Every normal
window now comes up with the console showing.

--- a/chrome/browser/ui/side_panel/side_panel_entry.h
+++ b/chrome/browser/ui/side_panel/side_panel_entry.h
@@ -35,6 +35,12 @@
 
   // The default and minimum acceptable side panel content width.
   static constexpr int kSidePanelDefaultContentWidth = 360;
+
+  // The narrowest a panel may be. Separate from the default above because the
+  // Flux console is specified at 305px: lowering the default would narrow
+  // every other panel with it, and lowering only the floor does not.
+  static constexpr int kSidePanelMinimumContentWidth = 305;
+
   using CreateContentCallback =
       base::RepeatingCallback<SidePanelNativeView(SidePanelEntryScope&)>;
   using Id = SidePanelEntryId;
--- a/chrome/browser/ui/side_panel/side_panel_entry.cc
+++ b/chrome/browser/ui/side_panel/side_panel_entry.cc
@@ -150,9 +150,9 @@
   }
 
   int preferred_default_width = default_content_width_callback_.Run();
-  // The default width must be greater than or equal to the default side panel
+  // The default width must be greater than or equal to the minimum side panel
   // width.
-  return preferred_default_width >= kSidePanelDefaultContentWidth
+  return preferred_default_width >= kSidePanelMinimumContentWidth
              ? preferred_default_width
              : default_content_width_;
 }
--- a/chrome/browser/ui/views/side_panel/side_panel.cc
+++ b/chrome/browser/ui/views/side_panel/side_panel.cc
@@ -399,7 +399,7 @@
 gfx::Size SidePanel::GetMinimumSize() const {
   const int min_height = 0;
   return gfx::Size(
-      SidePanelEntry::kSidePanelDefaultContentWidth + GetBorderInsets().width(),
+      SidePanelEntry::kSidePanelMinimumContentWidth + GetBorderInsets().width(),
       min_height);
 }
 
--- a/chrome/browser/ui/side_panel/side_panel_prefs.cc
+++ b/chrome/browser/ui/side_panel/side_panel_prefs.cc
@@ -39,6 +39,11 @@
   alignment_overrides.Set(
       SidePanelEntryIdToString(SidePanelEntryId::kContextualTasks),
       base::i18n::IsRTL());
+  // The Flux console is the browser's primary surface, and the reference
+  // design puts it on the leading edge. IsRTL() here means left in LTR - the
+  // dictionary stores "is right aligned", not "is on the leading edge".
+  alignment_overrides.Set(SidePanelEntryIdToString(SidePanelEntryId::kFlux),
+                          base::i18n::IsRTL());
   registry->RegisterDictionaryPref(prefs::kSidePanelAlignmentOverrides,
                                    std::move(alignment_overrides));
 #endif
--- a/chrome/browser/ui/browser_window/internal/browser_window_features.cc
+++ b/chrome/browser/ui/browser_window/internal/browser_window_features.cc
@@ -1027,6 +1027,15 @@
     }
   }
 
+  // Flux is the browser's primary surface rather than an occasional panel, so
+  // every normal window comes up with the console already open. This runs
+  // after side_panel_coordinator_ is built above, which is the earliest point
+  // at which there is a SidePanel to show it in.
+  if (side_panel_coordinator_ && browser->is_type_normal()) {
+    side_panel_coordinator_->Show(SidePanelEntryId::kFlux, std::nullopt,
+                                  /*suppress_animations=*/true);
+  }
+
   // Initialize post-window dependent embedder features last.
   embedder_browser_window_features_->InitPostWindowConstruction(browser);
 }
