import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "mojom/flux.mojom" ]
  public_deps = [
    "//mojo/public/mojom/base",
    "//url/mojom:url_mojom_gurl",
  ]
  webui_module_path = "/"
}

source_set("flux") {
  sources = [
    "flux_prefs.cc",
    "flux_prefs.h",
    "secret_store.cc",
    "secret_store.h",
    "connectors/connector_client.cc",
    "connectors/connector_client.h",
    "connectors/connector_registry.cc",
    "connectors/connector_registry.h",
    "connectors/connector_service.cc",
    "connectors/connector_service.h",
    "connectors/connector_tokens.cc",
    "connectors/connector_tokens.h",
    "connectors/oauth_flow.cc",
    "connectors/oauth_flow.h",
    "connectors/oauth_redirect_watcher.cc",
    "connectors/oauth_redirect_watcher.h",
    "flux_agent_service.cc",
    "flux_agent_service.h",
    "flux_agent_service_factory.cc",
    "flux_agent_service_factory.h",
    "webui/flux_page_handler.cc",
    "webui/flux_page_handler.h",
    "webui/flux_ui.cc",
    "webui/flux_ui.h",
    "agent/agent_runner.cc",
    "agent/agent_runner.h",
    "agent/ask_session.cc",
    "agent/ask_session.h",
    "agent/agent_tab.cc",
    "agent/agent_tab.h",
    "agent/page_context.cc",
    "agent/page_context.h",
    "agent/tool_registry.cc",
    "agent/tool_registry.h",
    "agent/tools/browser_tools.cc",
    "agent/tools/browser_tools.h",
    "agent/tools/connector_tools.cc",
    "agent/tools/file_tools.cc",
    "agent/tools/file_tools.h",
    "agent/tools/plan_tools.cc",
    "agent/tools/plan_tools.h",
    "agent/tools/connector_tools.h",
    "providers/anthropic_provider.cc",
    "providers/anthropic_provider.h",
    "providers/llm_provider.h",
    "providers/openai_provider.cc",
    "providers/openai_provider.h",
    "providers/provider_keys.cc",
    "providers/provider_keys.h",
    "skills/skill_registry.cc",
    "skills/skill_registry.h",
    "scheduler/workflow_scheduler.cc",
    "scheduler/workflow_scheduler.h",
  ]

  # One list, all public. flux_ui.h and flux_page_handler.h are included from
  # //chrome/browser/ui/views/side_panel to build the console's panel, and they
  # expose the mojom bindings, the KeyedService base and the TopChrome WebUI
  # base in their signatures. Splitting these would mean auditing every header
  # this target exports on every change; there is nothing to gain from it on a
  # leaf target with two dependents.
  public_deps = [
    ":mojo_bindings",
    "//base",

    # Targets under //chrome/browser depend on this rather than on
    # //chrome/browser directly; depending on the browser target is circular.
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/resources/flux:resources",
    # A narrow source_set exposing browser_navigator.h alone, not the whole
    # //chrome/browser/ui target - depending on that from here is circular.
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/webui/top_chrome",
    "//chrome/common",
    "//components/input",
    "//components/keyed_service/core",
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/common",
    "//components/prefs",
    "//content/public/browser",
    "//content/public/common",
    "//crypto",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/blink/public/common",
    "//ui/accessibility",
    "//ui/base",
    "//ui/events:events_base",
    "//ui/gfx/geometry",
    "//ui/webui",
    "//url",
  ]
}
