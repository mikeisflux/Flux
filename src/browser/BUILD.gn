import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "mojom/flux.mojom" ]
  public_deps = [
    "//mojo/public/mojom/base",
    "//url/mojom:url_mojom_gurl",
  ]
  webui_module_path = "/"
}

static_library("flux") {
  sources = [
    "flux_agent_service.cc",
    "flux_agent_service.h",
    "flux_agent_service_factory.cc",
    "flux_agent_service_factory.h",
    "webui/flux_page_handler.cc",
    "webui/flux_page_handler.h",
    "webui/flux_ui.cc",
    "webui/flux_ui.h",
    "agent/agent_runner.cc",
    "agent/agent_runner.h",
    "agent/page_context.cc",
    "agent/page_context.h",
    "agent/tool_registry.cc",
    "agent/tool_registry.h",
    "agent/tools/browser_tools.cc",
    "agent/tools/browser_tools.h",
    "providers/anthropic_provider.cc",
    "providers/anthropic_provider.h",
    "providers/llm_provider.h",
    "providers/openai_provider.cc",
    "providers/openai_provider.h",
    "providers/provider_keys.cc",
    "providers/provider_keys.h",
    "skills/skill_registry.cc",
    "skills/skill_registry.h",
    "scheduler/workflow_scheduler.cc",
    "scheduler/workflow_scheduler.h",
  ]

  deps = [
    ":mojo_bindings",
    "//base",
    "//chrome/browser/flux/resources:resources",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/core",
    "//content/public/browser",
    "//services/network/public/cpp",
    "//ui/accessibility",
  ]
}
