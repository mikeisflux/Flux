//
// The contract between the chrome://flux WebUI renderer and the browser-process
// agent service. Everything the console can do goes through here.

module flux.mojom;

import "mojo/public/mojom/base/time.mojom";
import "url/mojom/url.mojom";

// What a task is permitted to do without stopping to ask. Derived from the
// reference product, where write-safety was stated only in prose
// ("left unsent", "nothing sends without you") and never enforced.
// Flux makes it structural: the runner refuses any tool call whose effect
// exceeds the declared scope.
enum WriteScope {
  kReadOnly,   // navigate, read, extract. No mutation of remote state.
  kDraft,      // may compose and save drafts; may not transmit.
  kSend,       // may send messages, submit forms, post content.
  kPurchase,   // may complete transactions. Always gated on approval.
};

// How a service is reached. The reference product conflated these behind
// identical connector icons; their latency, reliability and failure modes are
// completely different, so the user is told which one a task depends on.
enum Transport {
  kApi,        // authenticated API. Stable contract, rate-limited.
  kBrowser,    // driving a live page. Breaks when the site changes.
  kMcp,        // reached over MCP. The server decides what exists.
};

enum RunState {
  kQueued,          // waiting on the parallelism cap
  kRunning,
  kAwaitingApproval,
  kPaused,
  kSucceeded,
  kFailed,
  kCancelled,
};

enum Provider {
  kAnthropic,
  kOpenAI,
};

struct ModelConfig {
  Provider provider;
  string model;              // e.g. "claude-opus-5", "gpt-5"
  uint32 max_output_tokens;
  // Fall back to the other provider if the primary errors or is rate-limited.
  bool allow_failover;
};

// A single action the agent took. The full ordered list is the run's audit
// trail, and is also what gets compiled into a deterministic replay.
struct ActionRecord {
  string tool_name;
  string summary;            // human-readable: "Clicked 'Next page'"
  url.mojom.Url? page_url;
  mojo_base.mojom.Time started_at;
  mojo_base.mojom.Time finished_at;
  bool succeeded;
  string? error;
  // Set when this action required and received human approval.
  bool was_approved;
};

// Raised when the agent wants to do something beyond its WriteScope.
// The run blocks until resolved.
struct ApprovalRequest {
  string run_id;
  string tool_name;
  string rationale;          // why the agent wants to do this
  string effect_summary;     // plain language: "Send this email to 12 people"
  url.mojom.Url? page_url;
  // Rendered so the user can see exactly what will happen.
  string? payload_preview;
};

// One line of the agent's plan. The model writes the plan before it starts and
// ticks items off as it goes, which is the difference between a progress bar
// that counts tool calls and one that says what is left to do.
struct TaskStep {
  string text;
  TaskStepState state;
};

enum TaskStepState {
  kPending,
  kActive,
  kDone,
  kSkipped,
};

// A file the run produced. Runs that end in "here is your spreadsheet" are the
// point of the product, and until now the answer only existed as prose in the
// summary.
struct ArtifactFile {
  string name;
  url.mojom.Url url;
};

struct RunArtifact {
  string title;
  // "Webpage", "Spreadsheet", "Document" - what the primary output is, shown
  // on the row beside Open.
  string kind;
  url.mojom.Url url;
  array<ArtifactFile> files;
};

struct RunProgress {
  string run_id;
  RunState state;
  string? current_step;
  uint32 actions_taken;
  // Metered cost. The reference product bills in credits but surfaces cost
  // nowhere in the task UI; Flux reports it live.
  uint32 input_tokens;
  uint32 output_tokens;
  uint64 credits_spent;
  // The plan, in order. Empty until the model sets one.
  array<TaskStep> plan;
  // Time spent in model inference since the last action, so the transcript can
  // say "Thought for 15s" rather than showing a gap.
  uint32 thinking_ms;
};

struct TaskSpec {
  string prompt;
  string? template_id;
  WriteScope write_scope;
  ModelConfig model;
  // Chromium profile this run acts as. Parallel runs get isolated contexts by
  // default so they cannot collide over cookies or single-session services.
  string profile_id;
  // Hard ceiling; the run fails closed rather than billing indefinitely.
  uint64 credit_budget;
};

// What the console needs to draw one row of the workflow table. Not the whole
// workflow: the instructions can be pages long and the list shows a summary.
struct WorkflowSummary {
  string id;
  string command;
  string name;
  string description;
  string cron;
  // Rendered for the row - "Daily at 7am" - because a cron expression is not
  // something to make a person parse at a glance. Empty when there is no
  // schedule.
  string schedule_display;
  // Null when it has never run, which the row says in words rather than
  // showing an epoch.
  mojo_base.mojom.Time? last_run;
  mojo_base.mojom.Time? next_run;
  bool enabled;
  // A firing that was missed because the machine was asleep. Surfaced rather
  // than swallowed: a workflow that never fired looks identical to one that
  // fired and found nothing.
  bool last_fire_missed;
  WriteScope write_scope;
};

// What the Save workflow dialog sends. `id` empty creates a new one.
struct WorkflowDraft {
  string id;
  string command;
  string name;
  string description;
  string cron;
  string schedule_display;
  TaskSpec spec;
  bool enabled;
};

// Browser -> renderer. Live updates for the console.
// What the connectors screen renders per row. Deliberately not the whole
// definition: the console already has names, descriptions and badges packed in
// connectors.json, and this is only the part that changes at runtime.
struct ConnectorStatus {
  string id;
  // False for the connectors there is no auth path for - a local one with
  // nothing to authorize, an MCP one configured elsewhere, or one catalogued
  // only so the console can say why it is not offered.
  bool connectable;
  // The user registered an OAuth app. Flux ships no client secrets, so this is
  // a precondition for connecting anything that uses OAuth.
  bool has_client;
  bool connected;
  // Connected but past its expiry, and the refresh has not run or failed.
  bool expired;
  // Why it is not connectable or what is missing, in words for the user.
  string? detail;
};

interface FluxPageHandlerObserver {
  OnRunProgress(RunProgress progress);
  OnAction(string run_id, ActionRecord action);
  OnApprovalRequested(ApprovalRequest request);
  OnRunFinished(string run_id, RunState final_state, string? summary);

  // A run produced a file. Sent as it happens rather than only at the end: a
  // long run that writes three artifacts should show the first one while it
  // is still working on the third.
  OnArtifact(string run_id, RunArtifact artifact);
  // Emitted when the agent writes back to the Instructions buffer, so the UI
  // can show provenance rather than silently mutating what the user wrote.
  OnLearnedFact(string fact, string source_run_id);

  // A connector connected, disconnected, or failed to connect. Carries the
  // whole row rather than an id, so the console never has to re-query to
  // redraw one card.
  OnConnectorChanged(ConnectorStatus status, string? error);
};

// Renderer -> browser.
interface FluxPageHandler {
  StartRun(TaskSpec spec) => (string run_id, string? error);
  CancelRun(string run_id);
  PauseRun(string run_id);
  ResumeRun(string run_id);

  ResolveApproval(string run_id, bool approved, string? user_note);

  ListRuns() => (array<RunProgress> runs);
  GetActions(string run_id) => (array<ActionRecord> actions);

  // Compile a successful run's action trace into a deterministic script that
  // replays without model inference. Turns an expensive agentic run into a
  // near-free repeatable one — the main lever against per-run credit cost.
  CompileReplay(string run_id) => (string? workflow_id, string? error);

  // Resolved concurrency, so the UI can show "Auto - 4 concurrent on this
  // machine" instead of an opaque setting.
  GetConcurrencyLimit() => (uint32 limit, uint32 active, uint32 queued);

  // --- Provider credentials -------------------------------------------------

  ListProviderKeys() => (array<ProviderKeyStatus> statuses);

  // Validates the key against the provider with a minimal request, then stores
  // it encrypted only if it works. Validating before storing means the user
  // finds out the key is wrong here, rather than three steps into a task that
  // then fails.
  SetProviderKey(Provider provider, string key)
      => (bool stored, string? error);

  ClearProviderKey(Provider provider);

  // Re-checks a stored key. Keys get revoked and quotas get exhausted; a
  // scheduled workflow failing at 7am should not be the first sign of it.
  ValidateProviderKey(Provider provider) => (bool valid, string? error);

  // --- Customize > Instructions ---------------------------------------------

  // The user's own text, and separately what the agent has learned. The
  // reference keeps one buffer that both write to, which is transparent but
  // lets the agent overwrite the user with no way to tell afterwards who wrote
  // what. Same transparency, two lists.
  GetInstructions() => (string text, array<LearnedFact> learned);

  SetInstructions(string text);

  // The user disagreeing with something the agent concluded. Individually
  // removable, because the alternative is editing a paragraph the agent will
  // just rewrite.
  DismissLearnedFact(string id);

  // --- Customize > Skills ---------------------------------------------------

  // Commands of the skills in the user's own set. The shipped library is a
  // catalog to adopt from; the console has it packed and only needs to know
  // which of them are live.
  ListAdoptedSkills() => (array<string> commands);

  // Copies a skill into the user's set, with whatever edits they made in the
  // form. Fails if the command collides - skills and workflows share one
  // command namespace, so a silent overwrite would shadow a workflow.
  AdoptSkill(string command, string name, string description,
             string instructions) => (bool adopted, string? error);

  RemoveSkill(string command);

  // --- Connectors -----------------------------------------------------------

  ListConnectors() => (array<ConnectorStatus> statuses);

  // The OAuth app the user registered with the provider. Flux ships no client
  // secrets - one inside a downloadable binary is not a secret - so each
  // connector is registered by the user as their own app.
  SetConnectorClient(string connector_id, string client_id,
                     string client_secret, string redirect_uri)
      => (bool stored, string? error);

  // Returns the client id and redirect URI for the form to show. The secret is
  // deliberately NOT returned: it goes into the encrypted store and never
  // comes back out to a renderer, so a compromised console cannot read it.
  GetConnectorClient(string connector_id)
      => (string client_id, string redirect_uri, bool has_secret);

  // Opens the provider's authorization page in a tab. The result arrives on
  // OnConnectorChanged, not here: the user has to go and approve it, which can
  // take any amount of time and can be abandoned.
  BeginConnect(string connector_id) => (bool started, string? error);

  // A pasted personal token, for the connectors that document one as an
  // alternative to the OAuth dance.
  SetPersonalToken(string connector_id, string token)
      => (bool stored, string? error);

  Disconnect(string connector_id);

  // Everything the run screen needs for a run it did not watch happen: a
  // reload, or opening one that finished while the console was elsewhere.
  // Null progress means the run is not known.
  GetRun(string run_id)
      => (RunProgress? progress,
          array<ActionRecord> actions,
          string? summary,
          array<RunArtifact> artifacts);

  // A message typed into a run's composer. Continues the run if it is still
  // going, and reopens it as a follow-up turn if it has finished.
  SendFollowUp(string run_id, string text) => (bool accepted, string? error);

  // --- Workflows -------------------------------------------------------------

  ListWorkflows() => (array<WorkflowSummary> workflows);

  // Creates one, or replaces the one with this id. `cron` may be empty for a
  // workflow that only ever runs on demand from the palette.
  SaveWorkflow(WorkflowDraft draft) => (string? workflow_id, string? error);

  DeleteWorkflow(string workflow_id);
  SetWorkflowEnabled(string workflow_id, bool enabled);

  // Fires it now, outside its schedule. Returns the run it started so the
  // console can follow it, the same as StartRun.
  RunWorkflowNow(string workflow_id) => (string? run_id, string? error);

  // --- The shell ------------------------------------------------------------

  // The console's column is browser chrome, so collapsing it is a window
  // layout change the frame has to make; the page cannot resize itself.
  GetSidebarCollapsed() => (bool collapsed);
  SetSidebarCollapsed(bool collapsed);

  // Navigates the window to a console screen: "templates", "connectors" and
  // so on, matching the fragments app.ts routes on.
  //
  // The sidebar is a different document from the tab, so it cannot simply set
  // location.hash. It used to be a target=_blank link relying on Blink's
  // new-window path reaching the sidebar view's OpenURLFromTab - which is a
  // long chain of renderer plumbing to depend on, and it did not arrive: the
  // nav row highlighted and the tab never moved. This says what it means
  // instead, over the pipe the shell already holds.
  ShowScreen(string screen);
};

// What the console is allowed to know about a stored key. Deliberately never
// the key itself: once written it is only ever read by the browser process on
// its way to the provider. The renderer gets enough to render state and no
// more.
struct ProviderKeyStatus {
  Provider provider;
  bool configured;
  // Last four characters, for "is this the key I think it is". Empty when
  // not configured.
  string hint;
  // Result of the last validation, so the console can distinguish "saved"
  // from "saved and known to work".
  bool validated;
  string? last_error;
};

// A thing the agent worked out about the user during a run. Kept apart from
// the user's own instructions so that neither can silently overwrite the
// other, and carrying its origin so "why does it think that" is answerable.
struct LearnedFact {
  string id;
  string text;
  string source_run_id;
  mojo_base.mojom.Time learned_at;
};

interface FluxPageHandlerFactory {
  CreatePageHandler(pending_remote<FluxPageHandlerObserver> observer,
                    pending_receiver<FluxPageHandler> handler);
};
