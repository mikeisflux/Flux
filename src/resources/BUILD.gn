import("//ui/webui/resources/tools/build_webui.gni")

build_webui("resources") {
  grd_prefix = "flux"
  static_files = [
    "index.html",
    "app.css",
  ]
  ts_files = [
    "app.ts",
    "runs.ts",
    "approvals.ts",
  ]
  mojo_files_deps = [ "//chrome/browser/flux:mojo_bindings_ts__generator" ]
  mojo_files = [
    "$root_gen_dir/chrome/browser/flux/mojom/flux.mojom-webui.js",
  ]
  ts_deps = [ "//ui/webui/resources/js:build_ts" ]
  webui_context_type = "trusted"
}
