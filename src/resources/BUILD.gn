import("//ui/webui/resources/tools/build_webui.gni")

build_webui("resources") {
  grd_prefix = "flux"
  static_files = [
    "index.html",
    "sidebar.html",
    "app.css",
    "flux-mark.svg",

    # Catalogues the console fetches at runtime. Static resources rather than
    # Mojo calls: neither changes while the browser is running, and every
    # screen that shows one wants all of it.
    "templates.json",
    "connectors.json",
    "skills.json",
  ]
  ts_files = [
    "app.ts",
    "sidebar.ts",
    "catalog.ts",
    "connectors_view.ts",
    "customize_view.ts",
    "skills.ts",
    "welcome_view.ts",
    "new_task_view.ts",
    "templates_view.ts",
    "workflows_view.ts",
    "runs.ts",
    "approvals.ts",
    "settings.ts",
  ]
  mojo_files_deps = [ "//chrome/browser/flux:mojo_bindings_ts__generator" ]
  mojo_files = [
    "$root_gen_dir/chrome/browser/flux/mojom/flux.mojom-webui.ts",
  ]
  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  webui_context_type = "trusted"
}
