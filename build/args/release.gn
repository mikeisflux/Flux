# Shipping build: official, ThinLTO + PGO. 4-6x slower than dev.gn.
# Self-contained - see the note in dev.gn.

# --- Fork identity -----------------------------------------------------------
# A fork must supply its own API keys. Chromium's are Google-internal and baked
# into official Google Chrome builds only. Without these, sync, safe-browsing,
# geolocation and translate are inert.
# Obtain at https://www.chromium.org/developers/how-tos/api-keys/
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""

# --- Media -------------------------------------------------------------------
# Required for a browser people will actually use: H.264, AAC, MP3.
# NOTE: shipping these carries patent-licensing obligations (MPEG-LA/Via).
# Chromium-branded builds ship without them; Chrome ships with them under
# Google's licenses. This is a legal decision, not a technical one.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# Widevine DRM (Netflix, Spotify, most paid video) requires a separate license
# agreement with Google. Left off; without it those sites will not play.
enable_widevine = false

# --- Trim --------------------------------------------------------------------
enable_reporting = false     # no telemetry endpoint of our own yet

is_debug = false
is_official_build = true      # enables full optimization + LTO
is_component_build = false    # single binary; required for shipping

# Level 1 keeps stack traces usable for crash triage without the ~40GB and long
# link times of level 2.
symbol_level = 1
blink_symbol_level = 0

use_thin_lto = true
chrome_pgo_phase = 2

# dcheck in release costs ~5% and catches real bugs in a young fork.
# Turn off once the agent layer stabilises.
dcheck_always_on = true

target_cpu = "x64"

# Siso's file store will not traverse a Windows directory junction, so it
# cannot see //chrome/browser/flux - the junction sync.ps1 creates so that
# editing src\ in this repo is picked up without copying files into the
# Chromium tree. GN resolves the junction correctly; only siso refuses.
#
# Plain ninja follows it. Siso's advantage is remote execution, which needs
# Google-internal RBE access we do not have - locally it just prints "offline
# mode" and builds the same graph. Nothing is being given up here.
use_siso = false
