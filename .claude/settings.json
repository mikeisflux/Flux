{
  "permissions": {
    "allow": [
      "Bash(python3 *)",
      "Bash(git *)",
      "Bash(cat *)",
      "Bash(ls *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/check-powershell.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/check-webui.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/check-ts-typemaps.py"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/check-patches.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/check-connectors.py"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/check-cpp.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/check-rebrand.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/check-includes.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/check-never-assigned.py"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/check-mojo-surface.py"
          }
        ]
      }
    ]
  }
}
